# MySQL. En Railway: ${{MySQL.MYSQL_URL}} (MYSQL_URL tambien funciona)
DATABASE_URL=mysql://user:password@host:3306/railway

# Firma de la sesion del admin. Cadena larga y aleatoria.
JWT_SECRET=

# Secreto para crear el PRIMER admin. Borrar de Railway despues de crearlo.
ADMIN_SETUP_TOKEN=

# Volumen de Railway. Sin R2, los archivos subidos desde el panel van aqui.
DATA_DIR=/app/data

# Opcional: true vuelve a cargar el catalogo que falte (el primer deploy lo hace solo).
SEED_CATALOG=

# Opcional: Cloudflare R2 (si esta, tiene prioridad sobre el volumen)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Opcional: aviso por email de cada mensaje de Contact Us (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
