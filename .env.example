# Copy to .env.local for development; configure these in the host for deployment.
ADMIN_PASSWORD=
SESSION_SECRET=
# Node filesystem persistence; mount a Railway volume here in production.
DATA_DIR=./data
# Optional. Set to the public HTTPS origin when behind a reverse proxy.
APP_ORIGIN=

# Public canonical domain (HTTPS); overrides APP_ORIGIN for SEO only.
SITE_URL=https://wickd-production.up.railway.app

# MySQL connection (server-only). Railway: reference MySQL.MYSQL_URL.
# Leaving this empty retains local JSON storage for development.
MYSQL_URL=
MYSQL_SSL=false

# Optional SMTP. Without these, contact messages are only saved in admin.
# SMTP_FROM is a plain email address authorized by your mail provider.
# 587 uses required STARTTLS; 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
